<odoo>
    <record id="ucs_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">ucs.res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="0"/>
        <field name="inherit_id" ref="project.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='analytic']" position="after">
            <h2>Allow Multi User To Start Task</h2>
                <div class="row mt16 o_settings_container" name="start_task">
                    <div class="col-12 col-lg-6 o_setting_box" id="allow_multi_user_to_start_task_setting">
                        <div class="o_setting_left_pane">
                            <field name="allow_multi_user_to_start_task"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="allow_multi_user_to_start_task"/>
                            <div class="text-muted">
                                Allow Multi User To Start Task
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>